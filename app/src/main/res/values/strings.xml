    <string name="saber_texture_title">Texture follows Saber\'s tool</string>
    <string name="saber_texture_summary">Each Saber tool gets its own texture and strength. Works even when \"Vibrate while writing\" is off, so the pen can vibrate only in Saber.</string>
    <string name="presentation_category">Presentation</string>
    <string name="presentation_title">Presentation mode</string>
    <string name="presentation_off">Off. Use the pen as a remote and pointer</string>
    <string name="presentation_on_touch">On · pointer moves while you touch the pen</string>
    <string name="presentation_on_always">On · pointer always follows the pen</string>
    <string name="presentation_intro">Use the pen as a remote and pointer for slides, documents, photos and maps. It uses the touch area near the tip, the same place you double tap. Presentation mode ends when you attach the pen to the tablet.</string>
