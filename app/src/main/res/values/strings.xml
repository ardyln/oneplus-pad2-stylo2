    <string name="presentation_mode_title">Pointer</string>
    <string name="pointer_touch_short">While touching</string>
    <string name="pointer_always_short">Always</string>
    <string name="pointer_touch_desc">The pointer only moves while a finger is on the touch area, so it stays put when you put the pen down or gesture with it.</string>
    <string name="pointer_always_desc">The pointer follows every movement of the pen, like a laser pointer. Handy for presenting, but it also moves while you hold the pen otherwise.</string>
