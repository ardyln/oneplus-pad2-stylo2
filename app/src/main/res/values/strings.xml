    <string name="button_buzz_title">Vibrate on each double tap</string>
    <string name="button_buzz_summary">A short vibration in the pen confirms that the double tap was detected</string>
    <string name="tap_window_title">Time to chain double taps</string>
    <string name="tap_window_summary">How long to wait for another double tap, in milliseconds. Shortcuts with fewer double taps run after this delay when longer ones exist.</string>
    <string name="broadcast_all_title">Broadcast every gesture</string>
    <string name="broadcast_all_summary">Sends io.github.ardyln.stylo2.action.DOUBLE_TAP with the extras taps and gesture, for Tasker and other automation apps</string>
    <string name="test_buzz_title">Test vibration</string>
    <string name="test_buzz_summary">Makes the pen vibrate once</string>

    <string name="notes_category">Notes apps</string>
    <string name="focus_service_label">Stylo 2: active app</string>
    <string name="focus_service_description">Tells the Stylo 2 app which app window is focused, so double taps and textures can follow notes apps like Saber. Only the package name of the focused window is read.</string>
    <string name="bridge_focus_off">Running, but the accessibility service "Stylo 2: active app" is off</string>
    <string name="stylus_button_apps_title">Double tap as stylus button</string>
    <string name="stylus_button_apps_summary">%1$s: a double tap holds or releases the stylus button instead of running shortcuts. Saber uses the stylus button as its eraser.</string>
