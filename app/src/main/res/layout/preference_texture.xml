<?xml version="1.0" encoding="utf-8"?>
<!-- Texture (icon buttons) and strength (slider) for writing feedback on the main page -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="72dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/texture_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/textures"
        style="@style/Widget.Material3Expressive.MaterialButtonToggleGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/texture_pencil"
            style="@style/Stylo2.TextureButton"
            android:contentDescription="@string/texture_pencil"
            app:icon="@drawable/ic_texture_pencil" />

        <Button
            android:id="@+id/texture_eraser"
            style="@style/Stylo2.TextureButton"
            android:contentDescription="@string/texture_eraser"
            app:icon="@drawable/ic_texture_eraser" />

        <Button
            android:id="@+id/texture_ballpen"
            style="@style/Stylo2.TextureButton"
            android:contentDescription="@string/texture_ballpen"
            app:icon="@drawable/ic_texture_ballpen" />

        <Button
            android:id="@+id/texture_pen"
            style="@style/Stylo2.TextureButton"
            android:contentDescription="@string/texture_pen"
            app:icon="@drawable/ic_texture_pen" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/strength_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <com.google.android.material.slider.Slider
        android:id="@+id/strength"
        style="@style/Widget.Material3Expressive.Slider.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/level_title"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="4"
        app:tickVisible="true" />
</LinearLayout>
