<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="status"
        android:title="@string/status_title"
        android:icon="@drawable/ic_stylus_note"
        android:selectable="false" />

    <Preference
        android:key="test_buzz"
        android:title="@string/test_buzz_title"
        android:summary="@string/test_buzz_summary"
        android:icon="@drawable/ic_action_buzz"
        android:persistent="false" />

    <PreferenceCategory android:title="@string/feedback_category">

        <SwitchPreferenceCompat
            android:key="feedback_enable"
            android:title="@string/feedback_switch"
            android:summary="@string/feedback_switch_summary"
            android:defaultValue="true"
            android:icon="@drawable/ic_action_texture"
            android:widgetLayout="@layout/preference_material_switch" />

        <io.github.ardyln.stylo2.TexturePreference
            android:key="feedback_texture_widget"
            android:persistent="false"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/button_category">

        <Preference
            android:key="shortcuts_screen"
            android:title="@string/shortcuts_title"
            android:icon="@drawable/ic_gesture_click"
            android:persistent="false"
            android:widgetLayout="@layout/preference_chevron" />

        <SwitchPreferenceCompat
            android:key="button_buzz"
            android:title="@string/button_buzz_title"
            android:summary="@string/button_buzz_summary"
            android:defaultValue="false"
            android:icon="@drawable/ic_action_buzz"
            android:widgetLayout="@layout/preference_material_switch" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/apps_category">

        <Preference
            android:key="saber_screen"
            android:title="@string/saber_title"
            android:icon="@drawable/ic_texture_pen"
            android:persistent="false"
            android:widgetLayout="@layout/preference_chevron" />

        <Preference
            android:key="stylus_apps_screen"
            android:title="@string/stylus_button_apps_title"
            android:icon="@drawable/ic_action_apps"
            android:persistent="false"
            android:widgetLayout="@layout/preference_chevron" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/presentation_category">

        <Preference
            android:key="presentation_screen"
            android:title="@string/presentation_title"
            android:icon="@drawable/ic_presentation"
            android:persistent="false"
            android:widgetLayout="@layout/preference_chevron" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/debug_category">

        <Preference
            android:key="debug_log"
            android:title="@string/debug_title"
            android:summary="@string/debug_summary"
            android:icon="@drawable/ic_bug"
            android:persistent="false"
            android:widgetLayout="@layout/preference_chevron" />

        <Preference
            android:key="focus_status"
            android:title="@string/focus_status_title"
            android:persistent="false" />

        <Preference
            android:key="bridge_status"
            android:title="@string/bridge_title"
            android:selectable="false" />

        <Preference
            android:key="reset_all"
            android:title="@string/reset_all_title"
            android:summary="@string/reset_all_summary"
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
